    layout {
        gaps 5 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

	focus-ring {
		width 2
        	active-color "#549bff" //cattppuccin mocha #c29df1 winter #549bff
        	inactive-color "#24273a"

	}

        struts {}
    }
